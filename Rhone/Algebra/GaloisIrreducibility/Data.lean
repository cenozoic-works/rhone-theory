  rw [show ((-308 : ℚ[X])) = C (-308 : ℚ) by rw [map_neg, map_ofNat],
    show ((11 : ℚ[X])) = C (11 : ℚ) from (map_ofNat C 11).symm,
    ← C_mul, ← C_mul, ← C_add, C_inj, thA1111, thB1111]
