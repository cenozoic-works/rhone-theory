set_option maxRecDepth 4096 in
set_option maxHeartbeats 800000 in
theorem weights_numerators (i : Fin 64) :
    histogramWeights i = (weightNumerators i : ℝ) / 1000000000000 := by
  fin_cases i <;> norm_num [histogramWeights, weightNumerators]

set_option maxRecDepth 4096 in
set_option maxHeartbeats 800000 in
theorem integer_prefixes (i : Fin 64) :
    (∑ j : Fin 64 with j < i, weightNumerators j) = prefixNumerators i := by
  fin_cases i <;> decide

theorem cumulative_values (i : Fin 64) :
    cumulative histogramWeights i = (prefixNumerators i : ℝ) / 1000000000000 := by
  unfold cumulative
  simp_rw [weights_numerators]
  rw [← Finset.sum_div]
  congr 1
  exact_mod_cast integer_prefixes i

theorem slope_values (i : Fin 64) :
    binSlope histogramWeights i = 64 * (weightNumerators i : ℝ) / 1000000000000 := by
  unfold binSlope
  rw [weights_numerators]
  ring

set_option maxRecDepth 4096 in
set_option maxHeartbeats 800000 in
theorem intercept_values (i : Fin 64) :
    binIntercept histogramWeights i = (interceptNumerators i : ℝ) / 1000000000000 := by
  unfold binIntercept
  rw [cumulative_values, weights_numerators]
  fin_cases i <;> norm_num [prefixNumerators, weightNumerators, interceptNumerators]

