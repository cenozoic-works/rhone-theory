theorem candidate_table_class (r : Row) :
    tableMass candidateMoments r = candidateClassMass (rowClass r) := by
  unfold tableMass coefficient
  rw [class_alignment, candidate_class_probabilities]

theorem exists_pan_candidate_law :
    ∃ r : ℝ → ℝ, LocallyIntegrable r volume ∧ (∀ t, 0 ≤ r t) ∧
      Tendsto (integratedClock r) atTop atTop ∧
      law (uniformBlockRoots 4 3 (by norm_num)) 2 (PanThreeSample.durationLaw r) =
        lawMeasure candidateLaw := by
  obtain ⟨r, hr, hn, ht, he⟩ := exists_proper_pan_histogram_observer
  refine ⟨r, hr, hn, ht, ?_⟩
  apply Measure.ext_of_singleton
  intro x
  rw [law_singleton, law_measure_singleton]
  apply congrArg ENNReal.ofReal
  rw [he x, histogram_moment_table, candidate_table_class]
  rfl

end Rhone.Statistics.ConcretePanGrid
