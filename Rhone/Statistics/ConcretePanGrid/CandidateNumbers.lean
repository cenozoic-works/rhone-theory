def candidateTermBudget : Fin 14 → ℕ := ![34245, 49957, 33007, 146707, 24637, 65600,
  187069, 239632, 97720, 37796, 18641, 208, 10719, 11907]

theorem candidate_class_positive (c : Fin 14) : 0 < candidateClassMass c := by
  fin_cases c <;> norm_num [candidateClassMass]

set_option maxRecDepth 4096 in
set_option maxHeartbeats 800000 in
theorem candidate_normalization :
    (∑ c : Fin 14, (sourceClassCount c : ℝ) * candidateClassMass c) = 1 := by
  norm_num [Fin.sum_univ_succ, sourceClassCount, candidateClassMass]

set_option maxRecDepth 4096 in
set_option maxHeartbeats 800000 in
theorem candidate_term_bound (c : Fin 14) :
    (sourceClassCount c : ℝ) * (sourceClassMass c - candidateClassMass c) ^ 2 /
      (sourceClassMass c + candidateClassMass c) ≤ candidateTermBudget c / 100000000000000 := by
  fin_cases c <;>
    norm_num [sourceClassCount, sourceClassMass, candidateClassMass, candidateTermBudget]

theorem candidate_budget :
    (∑ c : Fin 14, (candidateTermBudget c : ℝ) / 100000000000000) <
      9 / (16 * 38318671) := by
  norm_num [Fin.sum_univ_succ, candidateTermBudget]

