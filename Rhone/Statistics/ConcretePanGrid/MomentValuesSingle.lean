theorem weighted_value_1 : weightedQuadrature histogramWeights 1 = ((4109431120567837 :
    ℝ) / 12288000000000000) := by
  have hp := prefix_values (0 : Fin 3) (64 : Fin 65)
  change prefixPrimitive histogramWeights 1 64 = ((4109431120567837 : ℝ) / 12288000000000000)
    at hp
  simpa only [prefixPrimitive, weightedQuadrature,
    Finset.filter_true_of_mem (fun (i : Fin 64) _ => i.isLt)] using hp

