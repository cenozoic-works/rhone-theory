def classContrast (c : Fin 14) : ℝ :=
  contrast sourceMeans (fun i => (featureNumerators c i : ℝ) / 243)

set_option maxRecDepth 4096 in
set_option maxHeartbeats 800000 in
theorem source_class_counts (c : Fin 14) :
    (∑ r : Row with rowClass r = c,
      multiplicityNat r.1 * multiplicityNat r.2.1 * multiplicityNat r.2.2) =
        sourceClassCount c := by
  fin_cases c <;> decide

theorem class_alignment (r : Row) : polynomialClass r = rowClass r := by
  rfl

