theorem increment_bound (c : Fin 14) : |eta * (classContrast c + margin)| ≤ 1 / 100 := by
  rw [class_contrast_values]
  fin_cases c
  all_goals dsimp [eta, margin, contrastValues, ThreeSiteRobustness.scoreVector,
    ThreeSiteSeparator.score, ThreeSiteSeparator.linearScore, sourceMeans]
  all_goals norm_num

