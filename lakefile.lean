import Lake
open Lake DSL

-- Mathlib is pinned to a release tag and bumped by hand; `lake exe cache get` fetches its build.

package rhone where
  leanOptions := #[
    ⟨`pp.unicode.fun, true⟩,
    ⟨`relaxedAutoImplicit, false⟩,
    ⟨`maxSynthPendingDepth, 3⟩,
    ⟨`weak.linter.mathlibStandardSet, true⟩,
    -- Lean prose is titles and citations only, so no maxHeartbeats reason comment (SPEC 8.2 rule 2).
    ⟨`weak.linter.style.maxHeartbeats, false⟩
  ]

require mathlib from git "https://github.com/leanprover-community/mathlib4" @ "v4.35.0-rc3"

